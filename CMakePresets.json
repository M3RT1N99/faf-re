{
  "version": 6,
  "cmakeMinimumRequired": { "major": 3, "minor": 25, "patch": 0 },
  "configurePresets": [
    {
      "name": "clang-base",
      "hidden": true,
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build/${presetName}",
      "condition": { "type": "equals", "lhs": "${hostSystemName}", "rhs": "Windows" }
    },
    {
      "name": "clang-x64-release",
      "displayName": "clang-cl x64 Release (main_x64.exe)",
      "inherits": "clang-base",
      "toolchainFile": "${sourceDir}/cmake/toolchains/clang-cl-x64.cmake",
      "cacheVariables": { "CMAKE_BUILD_TYPE": "Release" }
    },
    {
      "name": "clang-x86-release",
      "displayName": "clang-cl x86 Release (main.exe)",
      "inherits": "clang-base",
      "toolchainFile": "${sourceDir}/cmake/toolchains/clang-cl-x86.cmake",
      "cacheVariables": { "CMAKE_BUILD_TYPE": "Release" }
    },
    {
      "name": "clang-x86-retail-layout",
      "displayName": "clang-cl x86 Release with the binary's exact container layout (checks the layout asserts)",
      "inherits": "clang-x86-release",
      "cacheVariables": { "FAF_RETAIL_LAYOUT": "ON" }
    },
    {
      "name": "clang-x64-profile",
      "displayName": "clang-cl x64 Profile with Tracy (main_x64.exe)",
      "inherits": "clang-x64-release",
      "cacheVariables": { "FAF_ENABLE_TRACY": "ON" }
    },
    {
      "name": "clang-x86-profile",
      "displayName": "clang-cl x86 Profile with Tracy (main.exe)",
      "inherits": "clang-x86-release",
      "cacheVariables": { "FAF_ENABLE_TRACY": "ON" }
    },
    {
      "name": "clang-x64-debug",
      "displayName": "clang-cl x64 Debug",
      "inherits": "clang-base",
      "toolchainFile": "${sourceDir}/cmake/toolchains/clang-cl-x64.cmake",
      "cacheVariables": { "CMAKE_BUILD_TYPE": "Debug" }
    },
    {
      "name": "clang-x86-debug",
      "displayName": "clang-cl x86 Debug",
      "inherits": "clang-base",
      "toolchainFile": "${sourceDir}/cmake/toolchains/clang-cl-x86.cmake",
      "cacheVariables": { "CMAKE_BUILD_TYPE": "Debug" }
    },
    {
      "name": "clang-x64-release-server",
      "displayName": "clang-cl x64 Release with server mode (main_x64.exe)",
      "inherits": "clang-x64-release",
      "cacheVariables": { "FAF_SERVER_MODE": "ON" }
    },
    {
      "name": "clang-x86-release-server",
      "displayName": "clang-cl x86 Release with server mode (main.exe)",
      "inherits": "clang-x86-release",
      "cacheVariables": { "FAF_SERVER_MODE": "ON" }
    },
    {
      "name": "linux-clang-x64-release",
      "displayName": "Linux clang x64 Release (headless simulation, profile-guided)",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build/${presetName}",
      "condition": { "type": "equals", "lhs": "${hostSystemName}", "rhs": "Linux" },
      "toolchainFile": "${sourceDir}/cmake/toolchains/linux-clang-x64.cmake",
      "cacheVariables": { "CMAKE_BUILD_TYPE": "Release", "FAF_PGO_PROFILE": "${sourceDir}/cmake/pgo/headless-linux-x64.profdata" }
    },
    {
      "name": "linux-clang-x64-release-plain",
      "displayName": "Linux clang x64 Release (headless simulation, no profile)",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build/${presetName}",
      "condition": { "type": "equals", "lhs": "${hostSystemName}", "rhs": "Linux" },
      "toolchainFile": "${sourceDir}/cmake/toolchains/linux-clang-x64.cmake",
      "cacheVariables": { "CMAKE_BUILD_TYPE": "Release" }
    },
    {
      "name": "linux-clang-x64-release-pgogen",
      "displayName": "Linux clang x64 Release (records a profile, tools/pgo/record.sh)",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build/${presetName}",
      "condition": { "type": "equals", "lhs": "${hostSystemName}", "rhs": "Linux" },
      "toolchainFile": "${sourceDir}/cmake/toolchains/linux-clang-x64.cmake",
      "cacheVariables": { "CMAKE_BUILD_TYPE": "Release", "FAF_PGO_GENERATE": "ON" }
    },
    {
      "name": "android-base",
      "hidden": true,
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build/${presetName}",
      "cacheVariables": { "CMAKE_BUILD_TYPE": "Release" }
    },
    {
      "name": "android-arm64-release",
      "displayName": "Android arm64-v8a Release (headless simulation)",
      "inherits": "android-base",
      "toolchainFile": "${sourceDir}/cmake/toolchains/android-arm64.cmake"
    },
    {
      "name": "android-x64-release",
      "displayName": "Android x86_64 Release (headless simulation, emulator)",
      "inherits": "android-base",
      "toolchainFile": "${sourceDir}/cmake/toolchains/android-x64.cmake"
    }
  ],
  "buildPresets": [
    { "name": "clang-x64-release", "configurePreset": "clang-x64-release" },
    { "name": "clang-x86-release", "configurePreset": "clang-x86-release" },
    { "name": "clang-x86-retail-layout", "configurePreset": "clang-x86-retail-layout" },
    { "name": "clang-x64-profile", "configurePreset": "clang-x64-profile" },
    { "name": "clang-x86-profile", "configurePreset": "clang-x86-profile" },
    { "name": "clang-x64-debug", "configurePreset": "clang-x64-debug" },
    { "name": "clang-x86-debug", "configurePreset": "clang-x86-debug" },
    { "name": "clang-x64-release-server", "configurePreset": "clang-x64-release-server" },
    { "name": "clang-x86-release-server", "configurePreset": "clang-x86-release-server" },
    { "name": "linux-clang-x64-release", "configurePreset": "linux-clang-x64-release" },
    { "name": "linux-clang-x64-release-plain", "configurePreset": "linux-clang-x64-release-plain" },
    { "name": "linux-clang-x64-release-pgogen", "configurePreset": "linux-clang-x64-release-pgogen" },
    { "name": "android-arm64-release", "configurePreset": "android-arm64-release" },
    { "name": "android-x64-release", "configurePreset": "android-x64-release" }
  ]
}
