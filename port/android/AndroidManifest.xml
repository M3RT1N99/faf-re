<?xml version="1.0" encoding="utf-8"?>
<!--
  One APK: the Java launcher (data import, launch options, replay test), the
  native game runtime (libfaf_android.so in GameActivity) and the headless
  replay runner (libfafrunner.so + libfafengine.so, a separate process the
  replay test starts). See docs/port/android.md.
  versionCode/versionName are set by scripts/port/build_android.ps1.
-->
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    package="io.github.m3rt1n99.fafre">

    <uses-sdk
        android:minSdkVersion="26"
        android:targetSdkVersion="35" />

    <!-- Vulkan 1.1 is preferred; the runtime falls back to OpenGL ES 3.0. -->
    <uses-feature
        android:name="android.hardware.vulkan.version"
        android:required="false"
        android:version="0x401000" />
    <uses-feature
        android:glEsVersion="0x00030000"
        android:required="true" />

    <!-- FAF file download (content.faforever.com). -->
    <uses-permission android:name="android.permission.INTERNET" />
    <!-- ImportService: long downloads and folder imports as a dataSync foreground service. -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_DATA_SYNC" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.WAKE_LOCK" />

    <!--
      hasFragileUserData: the imported game data (several GB) lives in the app's
      external files dir; Android 10+ asks whether to keep the app's data when it
      is uninstalled. allowBackup is off: the data is the user's own copy of the
      game and far too large for a backup.
      extractNativeLibs: the replay test execs lib/<abi>/libfafrunner.so as its
      own process, so the installer must extract the libraries into
      nativeLibraryDir (apps may only exec files from there, and only lib*.so
      names are extracted). build_android.ps1 packages them DEFLATED to match.
    -->
    <application
        android:allowBackup="false"
        android:appCategory="game"
        android:extractNativeLibs="true"
        android:hasCode="true"
        android:hasFragileUserData="true"
        android:icon="@mipmap/ic_launcher"
        android:isGame="true"
        android:label="@string/app_name"
        android:theme="@style/Theme.FafRe"
        tools:targetApi="29">

        <activity
            android:name=".LauncherActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!--
          The native runtime. Own process so a native crash never takes the
          launcher or a running import down; the launcher starts a fresh process
          for every run. Configuration changes are handled natively (swapchain
          resize), never by recreating the activity.
        -->
        <activity
            android:name=".GameActivity"
            android:configChanges="orientation|screenSize|screenLayout|smallestScreenSize|keyboard|keyboardHidden|navigation|uiMode|density"
            android:exported="false"
            android:launchMode="singleTask"
            android:process=":game"
            android:screenOrientation="sensorLandscape"
            android:theme="@style/Theme.FafRe.Game">
            <meta-data
                android:name="android.app.lib_name"
                android:value="faf_android" />
        </activity>

        <!--
          Receives a replay from "Open with" / "Share" (for example a
          https://replay.faforever.com/<id> download in the browser): copies it
          into <root>/replays and hands over to the launcher. No UI of its own.
          Only content: URIs are accepted; the file is checked for the replay
          format before anything else happens with it.
        -->
        <activity
            android:name=".ReplayInboxActivity"
            android:configChanges="orientation|screenSize|screenLayout|smallestScreenSize|keyboard|keyboardHidden|navigation|uiMode|density"
            android:excludeFromRecents="true"
            android:exported="true"
            android:label="FAF replay test"
            android:noHistory="true"
            android:taskAffinity=""
            android:theme="@android:style/Theme.Translucent.NoTitleBar">
            <intent-filter android:label="FAF replay test">
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:scheme="content" />
                <data android:mimeType="application/octet-stream" />
                <data android:mimeType="application/zstd" />
                <data android:mimeType="application/x-zstd" />
                <data android:mimeType="application/x-fafreplay" />
            </intent-filter>
            <intent-filter android:label="FAF replay test">
                <action android:name="android.intent.action.SEND" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="application/octet-stream" />
                <data android:mimeType="application/zstd" />
                <data android:mimeType="application/x-zstd" />
                <data android:mimeType="application/x-fafreplay" />
            </intent-filter>
        </activity>

        <!--
          Imports, downloads and the replay test (the headless runner as a child
          process of this, the main, process: the foreground service keeps both
          alive, see ReplayTest.java).
        -->
        <service
            android:name=".ImportService"
            android:exported="false"
            android:foregroundServiceType="dataSync" />
    </application>
</manifest>
