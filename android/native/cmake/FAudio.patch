diff --git a/src/FACT.c b/src/FACT.c
index ae299fb..7860ed1 100644
--- a/src/FACT.c
+++ b/src/FACT.c
@@ -248,6 +248,32 @@ uint32_t FACTAudioEngine_GetFinalMixFormat(
 	return FAUDIO_OK;
 }
 
+/* A category sounds at its authored volume, times what the program set, times
+ * its parent's: what comes down the hierarchy, whichever part of it changed.
+ */
+static void FACT_INTERNAL_UpdateCategoryVolume(
+	FACTAudioEngine *pEngine,
+	uint16_t nCategory
+) {
+	FACTAudioCategory *category = &pEngine->categories[nCategory];
+	uint16_t i;
+
+	category->currentVolume = category->volume * category->setVolume;
+	if (category->parentCategory != -1)
+	{
+		category->currentVolume *= pEngine->categories[
+			category->parentCategory
+		].currentVolume;
+	}
+	for (i = 0; i < pEngine->categoryCount; i += 1)
+	{
+		if (pEngine->categories[i].parentCategory == nCategory)
+		{
+			FACT_INTERNAL_UpdateCategoryVolume(pEngine, i);
+		}
+	}
+}
+
 uint32_t FACTAudioEngine_Initialize(
 	FACTAudioEngine *pEngine,
 	const FACTRuntimeParameters *pParams
@@ -255,6 +281,7 @@ uint32_t FACTAudioEngine_Initialize(
 	FAudioDeviceDetails device_details;
 	uint32_t parseRet;
 	uint32_t deviceIndex;
+	uint16_t i;
 	FAudioVoiceDetails masterDetails;
 	FAudioEffectDescriptor reverbDesc;
 	FAudioEffectChain reverbChain;
@@ -330,6 +357,18 @@ uint32_t FACTAudioEngine_Initialize(
 		}
 	}
 
+	for (i = 0; i < pEngine->categoryCount; i += 1)
+	{
+		pEngine->categories[i].setVolume = 1.0f;
+	}
+	for (i = 0; i < pEngine->categoryCount; i += 1)
+	{
+		if (pEngine->categories[i].parentCategory == -1)
+		{
+			FACT_INTERNAL_UpdateCategoryVolume(pEngine, i);
+		}
+	}
+
 	pEngine->notifications = NULL;
 	pEngine->notification_count = 0;
 	pEngine->notifications_capacity = 0;
@@ -870,23 +909,9 @@ uint32_t FACTAudioEngine_SetVolume(
 	uint16_t nCategory,
 	float volume
 ) {
-	uint16_t i;
 	FAudio_PlatformLockMutex(pEngine->apiLock);
-	pEngine->categories[nCategory].currentVolume = (
-		pEngine->categories[nCategory].volume *
-		volume
-	);
-	for (i = 0; i < pEngine->categoryCount; i += 1)
-	{
-		if (pEngine->categories[i].parentCategory == nCategory)
-		{
-			FACTAudioEngine_SetVolume(
-				pEngine,
-				i,
-				pEngine->categories[i].currentVolume
-			);
-		}
-	}
+	pEngine->categories[nCategory].setVolume = volume;
+	FACT_INTERNAL_UpdateCategoryVolume(pEngine, nCategory);
 	FAudio_PlatformUnlockMutex(pEngine->apiLock);
 	return FAUDIO_OK;
 }
