+/// The CPUs online, read once: the sim's worker pool asks for both masks on every dispatch, which opened and parsed
+/// the sysfs file each time. Windows' system mask does not change while a process runs, and the process mask beside
+/// it is read once too (`ProcessCpuSet`).
+[[nodiscard]] static DWORD_PTR OnlineCpus()
+{
+  static const DWORD_PTR online = ReadCpuListFile("/sys/devices/system/cpu/online");
+  return online;
+}
