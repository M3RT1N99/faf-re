+      FormatMemory(memory, sizeof(memory), report);
+      if (result == VK_SUCCESS) {
+        gpg::Logf(
+          "Vulkan: pipeline of %s built on try %u of %u; %s", report.pass.c_str(), refusals + 1U, kPipelineTries, memory
