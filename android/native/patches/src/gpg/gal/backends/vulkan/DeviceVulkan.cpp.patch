+      } else if (TriedAgain(refusals, result)) {
+        gpg::Warnf(
+          "Vulkan: pipeline of %s failed: %s; tried again in %.1f s, %u tries in all, the last in place; %s",
+          report.pass.c_str(),
+          vulkan::ResultName(result),
+          std::chrono::duration<double>(PipelineRetries::Spacing(refusals + 1U)).count(),
+          kPipelineTries,
+          memory
+        );
+      } else {
+        char attempt[32]{};
+        if (refusals != 0U) {
+          std::snprintf(attempt, sizeof(attempt), " on try %u of %u", refusals + 1U, kPipelineTries);
+        }
+        gpg::Warnf(
+          "Vulkan: pipeline of %s failed%s: %s; its draws are skipped; %s",
+          report.pass.c_str(),
+          attempt,
+          vulkan::ResultName(result),
+          memory
+        );
+      }
+    }
