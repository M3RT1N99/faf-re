+    /**
+     * `mesh.fx technique "T" pass "P" (vs VS, ps PS), vertex format 24`: a pipeline's pass as its effect describes it,
+     * the first pass with its entry points; a pair of them can serve several passes, which `and 2 more` counts.
+     */
+    [[nodiscard]] std::string PassLabel(
+      const effects::EffectProgram& program,
+      const effects::CompiledEntry& vertex,
+      const effects::CompiledEntry* const pixel,
+      const std::uint32_t format
+    )
+    {
+      const std::string pixelName = (pixel != nullptr) ? pixel->entryName : std::string();
+      const effects::Technique* technique = nullptr;
+      const effects::Pass* found = nullptr;
+      unsigned more = 0U;
+      for (const effects::Technique& candidate : program.Description().techniques) {
+        for (const effects::Pass& pass : candidate.passes) {
+          if (pass.vertexShader.entry != vertex.entryName || pass.pixelShader.entry != pixelName) {
+            continue;
+          }
+          if (found == nullptr) {
+            technique = &candidate;
+            found = &pass;
+          } else {
+            ++more;
+          }
+        }
+      }
+      std::string label = program.Name();
+      if (found != nullptr) {
+        label += " technique \"" + technique->name + "\" pass \"" + found->name + "\"";
+        if (more != 0U) {
+          label += " and " + std::to_string(more) + " more";
+        }
+      }
+      label += " (vs " + vertex.entryName;
+      if (pixel != nullptr) {
+        label += ", ps " + pixel->entryName;
+      }
+      return label + "), vertex format " + std::to_string(format);
+    }
