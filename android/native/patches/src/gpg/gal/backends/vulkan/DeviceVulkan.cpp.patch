+  void DeviceVulkan::ReleaseSurface(const std::size_t headIndex)
+  {
+    SwapChain& swapChain = mSwapChains[headIndex];
+    // The target gives up the images. What is recorded goes to the GPU, unshown, and with it go the views.
+    swapChain.images.clear();
+    swapChain.hasImage = false;
+    RebindBackBuffer(headIndex);
+    Submit(true, false);
+    Vk().vkDeviceWaitIdle(mDevice);
+    DestroySwapChain(swapChain, false);
+  }
