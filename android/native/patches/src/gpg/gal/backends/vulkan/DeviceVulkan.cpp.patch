+    /**
+     * `VmRSS 2412 MB, VmData 2641 MB, device-local 1203 of 3072 MB used, other 10 of 40 MB`: the process's resident
+     * and private memory (on Windows its working set and private bytes) and the device's use of its budget
+     * (VK_EXT_memory_budget), as the runtime info reads it, else the heaps' sizes.
+     */
+    void FormatMemory(
+      char* const text,
+      const std::size_t size,
+      const PipelineReport& report
+    )
+    {
+      constexpr unsigned long long kMiB = 1024ULL * 1024ULL;
+      int length = 0;
+      PROCESS_MEMORY_COUNTERS_EX process{};
+      process.cb = sizeof(process);
+      if (
+        ::GetProcessMemoryInfo(
+          ::GetCurrentProcess(), reinterpret_cast<PROCESS_MEMORY_COUNTERS*>(&process), sizeof(process)
+        )
+      ) {
+        length = std::snprintf(
+          text,
+          size,
+#if FAFRE_PLATFORM_WINDOWS
+          "working set %llu MB, private %llu MB, ",
+#else
+          "VmRSS %llu MB, VmData %llu MB, ",
+#endif
+          static_cast<unsigned long long>(process.WorkingSetSize) / kMiB,
+          static_cast<unsigned long long>(process.PrivateUsage) / kMiB
+        );
+      }
+      if (length < 0 || static_cast<std::size_t>(length) >= size) {
+        length = 0;
+      }
+      const MemoryBudget memory = ReadMemoryBudget(report.memoryProperties, report.physical, report.budget);
+      if (report.budget) {
+        std::snprintf(
+          text + length,
+          size - static_cast<std::size_t>(length),
+          "device-local %llu of %llu MB used, other %llu of %llu MB",
+          static_cast<unsigned long long>(memory.localUsage) / kMiB,
+          static_cast<unsigned long long>(memory.localBudget) / kMiB,
+          static_cast<unsigned long long>(memory.nonLocalUsage) / kMiB,
+          static_cast<unsigned long long>(memory.nonLocalBudget) / kMiB
+        );
+      } else {
+        std::snprintf(
+          text + length,
+          size - static_cast<std::size_t>(length),
+          "device-local heaps %llu MB, other %llu MB (no VK_EXT_memory_budget)",
+          static_cast<unsigned long long>(memory.local) / kMiB,
+          static_cast<unsigned long long>(memory.nonLocal) / kMiB
+        );
+      }
+    }
