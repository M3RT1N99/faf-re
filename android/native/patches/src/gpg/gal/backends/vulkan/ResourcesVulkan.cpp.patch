+  std::uint32_t IndexBufferVulkan::HighestIndex(const std::uint32_t start, const std::uint32_t count) const noexcept
+  {
+    const auto highest = [&]<typename Index>(const Index* const indices) {
+      const std::uint32_t held = mStorage.ByteWidth() / sizeof(Index);
+      const std::uint32_t first = std::min(start, held);
+      const std::uint32_t last = first + std::min(count, held - first);
+      Index result = 0;
+      for (std::uint32_t at = first; at < last; ++at) {
+        result = std::max(result, indices[at]);
+      }
+      return static_cast<std::uint32_t>(result);
+    };
+    return (IndexType() == VK_INDEX_TYPE_UINT16) ? highest(reinterpret_cast<const std::uint16_t*>(mStorage.Bytes()))
