+  /**
+   * The threads that build the deferred pipelines of `Handle` (kPipelineWorkerThreads), from the first build to the
+   * process's end: each build is a job in their queue. A thread of its own per build (std::async) made a thread, its
+   * stack and the driver's state for a thread anew each time. The worker is never destroyed: no job outlives the device
+   * it builds for, as a device takes its pending builds before it goes, and at the program's end the threads wait for
+   * jobs that do not come.
+   */
+  template <class Handle>
+  class PipelineWorker
+  {
+  public:
+    [[nodiscard]] static PipelineWorker& Instance()
+    {
+      static PipelineWorker* const worker = new PipelineWorker();
+      return *worker;
+    }
+
+    /** Queues `build`; its future is ready once a thread has run it. std::system_error when no thread can start. */
+    [[nodiscard]] std::future<Handle> Post(
+      std::packaged_task<Handle()> build
+    )
+    {
+      std::future<Handle> built = build.get_future();
+      {
+        const std::lock_guard<std::mutex> lock(mMutex);
+        StartThreads();
+        mJobs.push_back(std::move(build));
+      }
+      mWake.notify_one();
+      return built;
+    }
+
+    /**
+     * The builds the threads finished since the last call, each from its start on a thread to its end, the queue's wait
+     * not in it; and from then on none. A build's future is ready a moment before it counts. Any thread.
+     */
+    [[nodiscard]] PipelineBuildTimes TakeFinished()
+    {
+      const std::lock_guard<std::mutex> lock(mMutex);
+      return std::exchange(mFinished, PipelineBuildTimes{});
+    }
+
+    /**
+     * From a job, on the thread that runs it: what the driver said of its build (VkPipelineCreationFeedback), which
+     * the build's count takes along (TakeFinished). A job that says nothing counts its time alone.
+     */
+    static void Told(
+      const bool fromCache,
+      const std::chrono::steady_clock::duration driverTime
+    ) noexcept
+    {
+      tTelling = Telling{true, fromCache, driverTime};
+    }
+
+  private:
+    /** What the job running on this thread said of its build (Told). */
+    struct Telling
+    {
+      bool told = false;
+      bool fromCache = false;
+      std::chrono::steady_clock::duration driverTime{};
+    };
+    static inline thread_local Telling tTelling;
+
+    PipelineWorker() = default;
+
+    /** The threads not running yet: one the system refuses now is asked for again with the next job. */
+    void StartThreads()
+    {
+      while (mThreads < kPipelineWorkerThreads) {
+        try {
+          std::thread(&PipelineWorker::Run, this).detach();
+        } catch (const std::system_error&) {
+          if (mThreads == 0U) {
+            throw;
+          }
+          return;
+        }
+        ++mThreads;
+      }
+    }
+
+    [[noreturn]] void Run()
+    {
+#if FAFRE_PLATFORM_LINUX
+      (void)::pthread_setname_np(::pthread_self(), "faf-pipelines"); // as a tombstone names it
+#endif
+      for (;;) {
+        std::packaged_task<Handle()> build;
+        {
+          std::unique_lock<std::mutex> lock(mMutex);
+          mWake.wait(lock, [this] {
+            return !mJobs.empty();
+          });
+          build = std::move(mJobs.front());
+          mJobs.pop_front();
+        }
+        tTelling = Telling{};
+        const auto start = std::chrono::steady_clock::now();
+        build(); // what it throws goes into its future
+        const auto took = std::chrono::steady_clock::now() - start;
+        const std::lock_guard<std::mutex> lock(mMutex);
+        ++mFinished.count;
+        mFinished.time += took;
+        if (tTelling.told) {
+          ++mFinished.told;
+          mFinished.fromCache += tTelling.fromCache ? 1U : 0U;
+          mFinished.driverTime += tTelling.driverTime;
+        }
+      }
+    }
+
+    std::mutex mMutex;
+    std::condition_variable mWake;
+    std::deque<std::packaged_task<Handle()>> mJobs;
+    unsigned mThreads = 0U;
+    PipelineBuildTimes mFinished; // since TakeFinished
+  };
