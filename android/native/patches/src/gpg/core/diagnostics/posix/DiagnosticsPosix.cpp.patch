+        std::fprintf(sink, "\n== %s ==\n", gSections[section].name);
+        gSections[section].writer(sink, info);
+      }
+      std::fprintf(sink, "\n== Stack ==\n");
+      WriteStack(sink, 1);
+      for (; section < gSectionCount; ++section) {
+        std::fprintf(sink, "\n== %s ==\n", gSections[section].name);
+        gSections[section].writer(sink, info);
