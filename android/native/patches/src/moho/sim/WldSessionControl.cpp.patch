+    constexpr std::chrono::milliseconds kPipelineHoldPause{50};
+
+    /** Holds the session's start for its pipelines (wld_PipelineHoldSeconds); false when nothing is held. */
+    [[nodiscard]] bool BeginPipelineHold()
+    {
+      // At most an hour: the setting is the player's, and a duration from a float has to fit.
+      const float seconds = wld_PipelineHoldSeconds;
+      if (!(seconds > 0.0f)) {
+        return false;
+      }
+      const std::chrono::duration<double> limit(seconds < 3600.0f ? seconds : 3600.0f);
+      if (!gpg::gal::gPipelineStartHold.Begin(
+            std::chrono::steady_clock::now(), std::chrono::duration_cast<std::chrono::steady_clock::duration>(limit)
+          )) {
+        return false;
+      }
+      gpg::Logf(
+        "Session: the start waits on its loading screen for the pipelines of its meshes, map and units, %.0f s at most",
+        limit.count()
+      );
+      return true;
+    }
+
+    /** Whether a held start goes on now; its end has a line with how long it waited and what was built meanwhile. */
+    [[nodiscard]] bool PipelineHoldIsOver()
+    {
+      using gpg::gal::PipelineStartHold;
+      PipelineStartHold& hold = gpg::gal::gPipelineStartHold;
+      const auto now = std::chrono::steady_clock::now();
+      const PipelineStartHold::State state = hold.Update(now);
+      if (state == PipelineStartHold::State::kHolding) {
+        std::this_thread::sleep_for(kPipelineHoldPause);
+        return false;
+      }
+      const gpg::gal::PipelineHoldFrame& last = hold.LastFrame();
+      char cache[96] = "";
+      if (last.built.told != 0U) {
+        std::snprintf(
+          cache, sizeof(cache), "; the pipeline cache had %u of the %u the driver told of", last.built.fromCache,
+          last.built.told
+        );
+      }
+      const double held = std::chrono::duration<double>(hold.Held(now)).count();
+      if (state == PipelineStartHold::State::kSettled) {
+        gpg::Logf("Session: the start waited %.1f s for its pipelines: %u built%s", held, last.built.count, cache);
+      } else {
+        gpg::Logf(
+          "Session: the start waited its limit of %.0f s for its pipelines (wld_PipelineHoldSeconds), and goes on with "
+          "%zu still building and %zu to be tried again: %u built%s",
+          std::chrono::duration<double>(hold.Limit()).count(),
+          last.pending,
+          last.retries,
+          last.built.count,
+          cache
+        );
+      }
+      return true;
+    }
