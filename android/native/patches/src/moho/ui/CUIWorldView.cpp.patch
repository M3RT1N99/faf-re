+  /**
+   * Android client build (android/TOUCH_UI.md, "The draft"): what FAF's build mode draws while it is armed, for the app's
+   * draft (griffskirts::gDraft), which ends that mode, as a finger's tap makes a plan there, not an order. As DrawCommandGraph
+   * and DrawBuildDragAdjacencyHighlights draw it for the build drag's meshes: the skirts of the buildings ordered unless
+   * Shift is held, of each structure in view as far out as the picked building's mesh is drawn, brighter where a building of
+   * the draft's in the colour of a place it takes gains adjacency from it, and the draft's buildings', in their colours.
+   */
+  void DrawDraftSkirts(CameraImpl* const camera, CWldSession* const session, CD3DPrimBatcher* const batcher)
+  {
+    griffskirts::Draft draft;
+    if (griffskirts::gDraft == nullptr || !griffskirts::gDraft(draft) || draft.mesh == nullptr) {
+      return;
+    }
+
+    const GeomCamera3& view = camera->CameraGetView();
+    if (!MAUI_KeyIsDown(MKEY_SHIFT)) {
+      DrawAllUnitSkirts(batcher, session, view);
+    }
+
+    (void)batcher->Setup("TAlphaBlendLinearSampleNoDepth");
+    batcher->SetViewProjMatrix(view);
+    batcher->SetTexture(CD3DBatchTexture::FromSolidColor(0xFFFFFFFFu));
+
+    CHeightField* const heightField = session->mWldMap->mTerrainRes->GetHeightField();
+    for (const WeakPtr<UserEntity>& weakRef : *camera->GetArmyUnitsInFrustum()) {
+      UserEntity* const entity = weakRef.GetObjectPtr();
+      UserUnit* const unit = entity != nullptr ? entity->IsUserUnit() : nullptr;
+      if (unit == nullptr) {
+        continue;
+      }
+
+      IUnit* const iunit = GetIUnitBridge(unit);
+      if (iunit->IsDead() || iunit->DestroyQueued() || iunit->GetBlueprint()->IsMobile()) {
+        continue;
+      }
+
+      const Wm3::Vec3f& unitPosition = iunit->GetPosition();
+      if (view.viewport.ProjectViewportDepthRow1(unitPosition) >= draft.mesh->mIconFadeInZoom) {
+        continue;
+      }
+
+      std::uint32_t color = griffskirts::kFree;
+      gpg::Rect2f unitSkirt{};
+      (void)unit->GetSkirt(&unitSkirt);
+      for (griffskirts::Building& building : draft.buildings) {
+        if (building.color != griffskirts::kFree) {
+          continue;
+        }
+
+        const gpg::Rect2f skirt = building.blueprint->GetSkirtRect(SCoordsVec2{building.x, building.z});
+        if (AreSkirtsAdjacent(skirt, unitSkirt) && unit->DoOnDetectAdjacencyBonusFor(building.blueprint)) {
+          color = griffskirts::kAdjacent;
+          building.color = griffskirts::kAdjacent;
+          break;
+        }
+      }
+
+      DrawUnitSkirt(heightField, iunit->GetBlueprint(), view, unitPosition, session, batcher, color);
+    }
+
+    for (const griffskirts::Building& building : draft.buildings) {
+      DrawUnitSkirt(heightField, building.blueprint, view, Wm3::Vector3f{building.x, building.y, building.z}, session, batcher,
+        building.color);
+    }
+
+    batcher->Flush();
+  }
+
