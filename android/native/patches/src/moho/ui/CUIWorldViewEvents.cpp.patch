+// Android client build: placing a building by finger (CUIWorldView::HandleEvent), and what the app,
+// on its own thread, asks about it.
+namespace
+{
+  std::atomic<bool> sPlacingBuilding{false};
+  std::atomic<bool> sGamePlaying{false};
+  std::atomic<moho::CUIWorldView*> sMainWorldView{nullptr};
+
+  /** What the world's next press would be for, if anything: an order, a ping, a building. Ask only with a world view up. */
+  [[nodiscard]] msvc8::string CommandMode()
+  {
+    moho::UICommandModeData commandMode{};
+    moho::UI_GetCommandMode(commandMode);
+    return commandMode.mMode;
+  }
+
+  [[nodiscard]] bool IsPlacingBuilding()
+  {
+    const msvc8::string mode = CommandMode();
+    return mode == "build" || mode == "buildanchored";
+  }
+
+  /** The world view a press on this control comes to: a press goes on to the parents, past what does not take it, such as a marker on the map. */
+  [[nodiscard]] moho::CUIWorldView* WorldViewOf(moho::CMauiControl* control)
+  {
+    for (; control != nullptr; control = control->GetParent()) {
+      if (moho::CUIWorldView* const view = dynamic_cast<moho::CUIWorldView*>(control)) {
+        return view;
+      }
+    }
+    return nullptr;
+  }
+
+  [[nodiscard]] taptarget::Box BoxOf(moho::CMauiControl* const control)
+  {
+    return taptarget::Box{
+      moho::CScriptLazyVar_float::GetValue(&control->mLeftLV), moho::CScriptLazyVar_float::GetValue(&control->mTopLV),
+      moho::CScriptLazyVar_float::GetValue(&control->mRightLV), moho::CScriptLazyVar_float::GetValue(&control->mBottomLV)
+    };
+  }
+
+  /**
+   * A window's title or one of its resize edges (lua/maui/window.lua names them so). They take a drag, and a press that moves
+   * nothing does no more than save the window's place, which then counts as the place the user chose.
+   */
+  [[nodiscard]] bool IsWindowHandle(moho::CMauiControl* const control)
+  {
+    const moho::CMauiControl* const parent = control->GetParent();
+    return control->mDebugName == "window title group" || (parent != nullptr && parent->mDebugName == "window resize group");
+  }
+
+  /** A finger's press can act on it: one of the engine's, or by its handlers in Lua (taptarget::ActsOnAPress). */
+  [[nodiscard]] bool IsLive(moho::CMauiControl* const control, const LuaPlus::LuaObject& plainHandler)
+  {
+    if (dynamic_cast<moho::CMauiItemList*>(control) != nullptr || dynamic_cast<moho::CMauiEdit*>(control) != nullptr
+        || dynamic_cast<moho::CMauiScrollbar*>(control) != nullptr) {
+      return true;
+    }
+    LuaPlus::LuaObject handler;
+    LuaPlus::LuaObject wrapped;
+    control->FindScript(&handler, "HandleEvent");
+    control->FindScript(&wrapped, "oldHandleEvent");
+    return !IsWindowHandle(control) && taptarget::ActsOnAPress(handler, wrapped, plainHandler);
+  }
+
+  /** Whether `part` is `whole` or lies within it. */
+  [[nodiscard]] bool IsPartOf(moho::CMauiControl* part, const moho::CMauiControl* const whole)
+  {
+    for (; part != nullptr; part = part->GetParent()) {
+      if (part == whole) {
+        return true;
+      }
+    }
+    return false;
+  }
