+#include <atomic>
+
+// Android client build: placing a building by finger (CUIWorldView::HandleEvent), and what the app,
+// on its own thread, asks about it.
+namespace
+{
+  std::atomic<bool> sPlacingBuilding{false};
+  moho::CUIWorldView* sMainWorldView = nullptr;
+
+  [[nodiscard]] bool IsPlacingBuilding()
+  {
+    moho::UICommandModeData commandMode{};
+    moho::UI_GetCommandMode(commandMode);
+    return commandMode.mMode == "build" || commandMode.mMode == "buildanchored";
+  }
+} // namespace
+
+namespace moho
+{
+  /** Whether a building's ghost waits to be placed, as the last frame saw it. */
+  bool UI_PlacingBuilding() noexcept
+  {
+    return sPlacingBuilding.load();
+  }
+
+  /** Whether a press here would come to a world view, not stay with the UI over it. On the window thread. */
+  bool UI_WorldViewAt(const float x, const float y)
+  {
+    CMauiControl* root = ResolveTopInputCaptureControl();
+    if (root == nullptr && sMainWorldView != nullptr) {
+      root = sMainWorldView->GetRootFrame();
+    }
+    if (root == nullptr) {
+      return false;
+    }
+    // What a press finds goes on to the parents, as a marker on the map does that does not take it.
+    for (CMauiControl* control = CMauiControl::GetTopmostControl(root, x, y); control != nullptr; control = control->GetParent()) {
+      if (dynamic_cast<CUIWorldView*>(control) != nullptr) {
+        return true;
+      }
+    }
+    return false;
+  }
+} // namespace moho
