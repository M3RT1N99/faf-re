+  /** Whether a building's ghost waits to be placed, as the last frame saw it. */
+  bool UI_PlacingBuilding() noexcept
+  {
+    return sPlacingBuilding.load();
+  }
+
+  /** Whether a game goes on behind the game's UI, as the last frame saw it: not in the menus, and not on the score screen. */
+  bool UI_GamePlaying() noexcept
+  {
+    return sGamePlaying.load();
+  }
+
+  /** Whether a press here would come to a world view, not stay with the UI over it. On the window thread. */
+  bool UI_WorldViewAt(const float x, const float y)
+  {
+    CMauiControl* root = ResolveTopInputCaptureControl();
+    if (root == nullptr && sMainWorldView.load() != nullptr) {
+      root = sMainWorldView.load()->GetRootFrame();
+    }
+    if (root == nullptr) {
+      return false;
+    }
+    return WorldViewOf(CMauiControl::GetTopmostControl(root, x, y)) != nullptr;
+  }
+
+  /** Whether a building's ghost waits now, at this place over the world, where the pointer is with it. On the window thread. */
+  bool UI_GhostWaitsAt(const float x, const float y)
+  {
+    // The menus' Lua has no command mode to ask.
+    return sMainWorldView.load() != nullptr && IsPlacingBuilding() && UI_WorldViewAt(x, y);
+  }
+
+  /**
+   * Where a finger's tap at this place clicks (android/TOUCH_UI.md): the small control it meant, if one is within reach, at the
+   * pixel of it nearest to the tap. Otherwise where it landed: on the minimap; on the world with a command mode armed, which
+   * wants that very place; on what a finger can act on that is not small; on the world far from any small control. False
+   * when there is nothing to click: only a window's title or edge is there. On the window thread.
+   */
+  bool UI_TapTarget(const float x, const float y, const float reach, const float smallSide, float* const targetX, float* const targetY)
+  {
+    *targetX = x;
+    *targetY = y;
+    try {
+      CMauiControl* root = ResolveTopInputCaptureControl();
+      if (root == nullptr && g_UIManager != nullptr && !g_UIManager->mFrames.Empty()) {
+        root = g_UIManager->mFrames[0].get();
+      }
+      if (root == nullptr) {
+        return true;
+      }
+      const LuaPlus::LuaObject plainHandler =
+        SCR_Import(root->mLuaObj.GetActiveState(), "/lua/maui/control.lua")["Control"]["HandleEvent"];
+
+      CMauiControl* const top = CMauiControl::GetTopmostControl(root, x, y);
+      if (CUIWorldView* const view = WorldViewOf(top)) {
+        if (view->IsMiniMap() || !CommandMode().empty()) {
+          return true;
+        }
+      } else if (top != nullptr && IsLive(top, plainHandler) && !BoxOf(top).IsSmall(smallSide)) {
+        return true;
+      }
+      taptarget::Nearest<CMauiControl> nearest(x, y, reach, smallSide);
+      for (CMauiControl* control = root; control != nullptr; control = control->DepthFirstSuccessor(root)) {
+        // Nobody aims at what cannot be seen, such as an unused panel that stands there faded out.
+        if (control->IsHidden() || control->IsHitTestDisabled() || control->GetAlpha() <= 0) {
+          continue;
+        }
+        const taptarget::Box box = BoxOf(control);
+        if (nearest.Wants(box) && IsLive(control, plainHandler)) {
+          // What a press there finds has to be it or a part of it, not what lies over it.
+          const taptarget::Place pixel = box.NearestPixel(x, y);
+          if (IsPartOf(CMauiControl::GetTopmostControl(root, pixel.x, pixel.y), control)) {
+            nearest.Take(control, box);
+          }
+        }
+      }
+      if (nearest.Best() != nullptr) {
+        const taptarget::Place target = nearest.Target();
+        *targetX = target.x;
+        *targetY = target.y;
+        return true;
+      }
+      return top == nullptr || !IsWindowHandle(top);
+    } catch (const std::exception& exception) {
+      gpg::Warnf("UI_TapTarget: %s", exception.what());
+      return true;
+    }
+  }
