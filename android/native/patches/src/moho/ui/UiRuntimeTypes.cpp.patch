+  /** Whether a press here would come to a world view, not stay with the UI over it. On the window thread. */
+  bool UI_WorldViewAt(const float x, const float y)
+  {
+    CMauiControl* root = ResolveTopInputCaptureControl();
+    if (root == nullptr && sMainWorldView != nullptr) {
+      root = sMainWorldView->GetRootFrame();
+    }
+    if (root == nullptr) {
+      return false;
+    }
+    // What a press finds goes on to the parents, as a marker on the map does that does not take it.
+    for (CMauiControl* control = CMauiControl::GetTopmostControl(root, x, y); control != nullptr; control = control->GetParent()) {
+      if (dynamic_cast<CUIWorldView*>(control) != nullptr) {
+        return true;
+      }
+    }
+    return false;
+  }
