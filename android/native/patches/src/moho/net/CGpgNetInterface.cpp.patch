+  /**
+   * Android client build: a game started with `/gpgnet` alone has nothing but its launcher until the launcher's
+   * `CreateLobby`. gpgnet.lua leaves the screen empty, and FAF's Esc handler fails on it, so a launcher that could
+   * not be reached, or that went before then, left the player there for good. On the command that says so, this
+   * says it on the screen and ends the game, as StartGpgNetFromCommandLine (CScApp.cpp) does when the attach fails,
+   * and returns true. A game that comes back with `/rejoin`, or plays on a game server, has a screen of its own and
+   * needs the launcher for its results alone.
+   */
+  [[nodiscard]] bool EndWithoutLauncher(
+    const fa::string& commandName,
+    const fa::vector<SNetCommandArg>& args
+  )
+  {
+    fa::string reason;
+    if (commandName == "ConnectFailed") {
+      reason = "the connection failed"; // NET_TCPConnect logged why
+    } else if (commandName == "ConnectionShutdown") {
+      reason = "the connection closed before the lobby";
+    } else if (commandName == "CommunicationError") {
+      reason = args.empty() ? fa::string("communication error") : args[0].mStr;
+    } else {
+      return false;
+    }
+#if FAF_SERVER_MODE
+    if (faf::remote::ServerSessionStarted()) {
+      return false;
+    }
+#endif
+    if (moho::CFG_GetArgOption(gpg::StrArg{"/rejoin"}, 0u, nullptr)) {
+      return false;
+    }
+
+    fa::vector<fa::string> endpoint;
+    (void)moho::CFG_GetArgOption(gpg::StrArg{"/gpgnet"}, 1u, &endpoint);
+    const fa::string message = gpg::STR_Printf(
+      "Unable to connect to gpgnet endpoint \"%s\":\n%s", endpoint.empty() ? "" : endpoint[0].c_str(), reason.c_str()
+    );
+    gpg::Warnf("GPGNET: %s", message.c_str());
+    WIN_OkBox("Ack!", message.c_str());
+    if (sAppExitMainLoop != nullptr) {
+      sAppExitMainLoop();
+    }
+    return true;
+  }
+
