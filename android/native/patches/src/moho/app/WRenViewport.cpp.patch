+  /// The screen-space projection REN_DebugStuff sets: a head's pixels, origin top left.
+  [[nodiscard]] moho::VMatrix4 HeadPixelProjection(
+    const float widthF,
+    const float heightF
+  )
+  {
+    moho::VMatrix4 projection{};
+    projection.r[0] = {2.0f / widthF, 0.0f, 0.0f, 0.0f};
+    projection.r[1] = {0.0f, 2.0f / (-0.0f - heightF), 0.0f, 0.0f};
+    projection.r[2] = {0.0f, 0.0f, -0.5f, 0.0f};
+    projection.r[3] = {
+      (widthF / (-0.0f - widthF)) - (1.0f / widthF), (heightF / heightF) + (1.0f / heightF), 0.5f, 1.0f
+    };
+    return projection;
+  }
