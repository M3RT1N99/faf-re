+  // Engine addition (a replay's move, moho::gReplayFastForward): a move draws no world. Its first frame draws the world
+  // once more and keeps that picture of each head, dimmed; the frames until the move's end show it in place of the
+  // world, under the UI, which goes on as before (the timeline's strip of the move and its Cancel). What the world's
+  // frame costs stops meanwhile: the views with their effects and overlays, the cartographic views, the bloom, and the
+  // pipelines and textures a first draw of the move's new meshes would build.
+  enum class EWorldFrame
+  {
+    Draw,
+    DrawAndKeep,
+    ShowKept,
+  };
+
+  struct SKeptWorld
+  {
+    moho::ID3DDeviceResources::RenderTargetHandle target;
+    int width = 0;
+    int height = 0;
+  };
+
+  // A head each, as the viewport's own targets.
+  SKeptWorld sKeptWorlds[2];
+  // What Render does with the world, which D3DWindowOnDeviceRender sets for each head: a preview's render draws.
+  EWorldFrame sWorldFrame = EWorldFrame::Draw;
+  // ARGB: the black over the kept picture, so that it reads as still and the UI stands out.
+  constexpr std::uint32_t kKeptWorldDim = 0x60000000u;
+
+  /** What this frame does with the world of `head`; a move's picture goes once the move is over. */
+  [[nodiscard]] EWorldFrame TakeWorldFrame(
+    moho::CD3DDevice& device,
+    const int head
+  )
+  {
+    if (head < 0 || head >= static_cast<int>(std::size(sKeptWorlds))) {
+      return EWorldFrame::Draw;
+    }
+    SKeptWorld& kept = sKeptWorlds[head];
+    if (!moho::gReplayFastForward.load(std::memory_order_relaxed)) {
+      kept = SKeptWorld{};
+      return EWorldFrame::Draw;
+    }
+    const int width = device.GetHeadWidth(static_cast<unsigned int>(head));
+    const int height = device.GetHeadHeight(static_cast<unsigned int>(head));
+    if (kept.target && kept.width == width && kept.height == height) {
+      return EWorldFrame::ShowKept;
+    }
+    // None yet, or the head has another size now (a phone turned): drawn and kept again.
+    kept = SKeptWorld{};
+    return EWorldFrame::DrawAndKeep;
+  }
+
+  /** Dims the world just drawn on `head` and keeps it; without a target to keep it in, the frame stays as drawn. */
+  void KeepWorld(
+    moho::CD3DDevice& device,
+    moho::CD3DPrimBatcher& primBatcher,
+    const int head
+  )
+  {
+    SKeptWorld& kept = sKeptWorlds[head];
+    const int width = device.GetHeadWidth(static_cast<unsigned int>(head));
+    const int height = device.GetHeadHeight(static_cast<unsigned int>(head));
+    device.GetResources()->CreateRenderTarget(kept.target, width, height, kViewportHeadTargetFormat);
+    if (!kept.target) {
+      return;
+    }
+
+    device.SetRenderTarget2(head, false, 0, 1.0f, 0);
+    Wm3::Vector2i origin{0, 0};
+    Wm3::Vector2i size{width, height};
+    device.SetViewport(&origin, &size, 0.0f, 1.0f);
+    device.SetColorWriteState(true, false);
+    device.SelectFxFile("primbatcher");
+    device.SelectTechnique("TAlphaBlendLinearSampleNoDepth");
+    primBatcher.mRebuildComposite = 0;
+    const float right = static_cast<float>(width);
+    const float bottom = static_cast<float>(height);
+    primBatcher.SetProjectionMatrix(HeadPixelProjection(right, bottom));
+    primBatcher.SetViewMatrix(moho::VMatrix4::Identity());
+    primBatcher.SetTexture(moho::CD3DBatchTexture::FromSolidColor(0xFFFFFFFFu));
+    primBatcher.DrawQuad(
+      moho::Vector3f{0.0f, 0.0f, 0.0f},
+      moho::Vector3f{right, 0.0f, 0.0f},
+      moho::Vector3f{right, bottom, 0.0f},
+      moho::Vector3f{0.0f, bottom, 0.0f},
+      kKeptWorldDim
+    );
+    primBatcher.Flush();
+
+    std::shared_ptr<moho::ID3DRenderTarget> headTarget{};
+    device.GetWriterLock1(headTarget, head);
+    device.SetViewRect(headTarget.get(), kept.target.get(), nullptr, nullptr);
+    kept.width = width;
+    kept.height = height;
+  }
+
+  /** The move's kept picture on `head`, in place of the world, with the head bound for the UI over it. */
+  void ShowKeptWorld(
+    moho::CD3DDevice& device,
+    const int head
+  )
+  {
+    const SKeptWorld& kept = sKeptWorlds[head];
+    std::shared_ptr<moho::ID3DRenderTarget> headTarget{};
+    device.GetWriterLock1(headTarget, head);
+    device.SetViewRect(kept.target.get(), headTarget.get(), nullptr, nullptr);
+    device.SetRenderTarget2(head, false, 0, 1.0f, 0);
+    Wm3::Vector2i origin{0, 0};
+    Wm3::Vector2i size{kept.width, kept.height};
+    device.SetViewport(&origin, &size, 0.0f, 1.0f);
+    device.SetColorWriteState(true, false);
+  }
 } // namespace
 
