<?xml version="1.0" encoding="utf-8"?>
<!--
  The engine test app: runs the engine's sim-math tests and plays FAF vault replays with
  the headless simulation (libfafheadless.so, started as its own process), checking every
  checksum the players recorded. See android/README.md.
-->
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- FAF's game files, replays, maps and mods (content.faforever.com, replay.faforever.com), the game's lobby and network games. -->
    <uses-permission android:name="android.permission.INTERNET" />
    <!-- GameActivity's multicast lock: Wi-Fi hands a phone the broadcasts that find LAN games only under it. -->
    <uses-permission android:name="android.permission.CHANGE_WIFI_MULTICAST_STATE" />
    <!-- TestService: downloads and test runs keep going with the screen off or the app in the background. NetworkGameService: so does a network game. -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_DATA_SYNC" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SPECIAL_USE" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.WAKE_LOCK" />

    <!--
      hasFragileUserData: the imported game data (the user's own copy) lives in the app's
      external files dir; Android asks whether to keep it on uninstall. allowBackup is off: the
      data is the user's own copy of the game and far too large for a backup.
      extractNativeLibs: the tests start lib/<abi>/libfafheadless.so as a process, and an app may
      only start files from nativeLibraryDir, where only extracted lib*.so files land.
      appCategory game: the system files the app as the game it tests, as phones' game modes and
      Samsung's Game Booster tell games from other apps (0.6.2 found the CPU clock capped).
      isGame is the older flag for the same (deprecated since Android 8, still read by some game
      launchers); the game_mode_config meta-data below is Android 13's game mode configuration.
    -->
    <application
        android:allowBackup="false"
        android:appCategory="game"
        android:isGame="true"
        android:extractNativeLibs="true"
        android:hasFragileUserData="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:theme="@style/Theme.FafRe"
        tools:targetApi="29">

        <meta-data
            android:name="android.game_mode_config"
            android:resource="@xml/game_mode_config" />

        <activity
            android:name=".MainActivity"
            android:configChanges="orientation|screenSize|screenLayout|smallestScreenSize|keyboardHidden|density"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- The renderer test (GalSmoke): a full-screen surface for the engine's Vulkan device, in a
             process of its own, so a crash in the phone's Vulkan driver leaves the app running. -->
        <activity
            android:name=".GalSmokeActivity"
            android:process=":renderer"
            android:configChanges="orientation|screenSize|screenLayout|smallestScreenSize|keyboardHidden|density"
            android:exported="false"
            android:theme="@android:style/Theme.Black.NoTitleBar.Fullscreen" />

        <!-- The game (libfafgame.so): the engine's program on a full-screen surface, in a process of
             its own that ends with the program, as a Windows program's does. Landscape, as the
             game is; it takes every configuration change itself, as a Windows window does. -->
        <activity
            android:name=".GameActivity"
            android:process=":game"
            android:screenOrientation="sensorLandscape"
            android:windowSoftInputMode="adjustNothing|stateHidden"
            android:configChanges="orientation|screenSize|screenLayout|smallestScreenSize|keyboard|keyboardHidden|navigation|density|uiMode|mcc|mnc|locale|touchscreen|fontScale|fontWeightAdjustment|grammaticalGender|layoutDirection|colorMode"
            android:exported="false"
            android:theme="@android:style/Theme.Black.NoTitleBar.Fullscreen" />

        <service
            android:name=".TestService"
            android:exported="false"
            android:foregroundServiceType="dataSync" />

        <!-- specialUse: dataSync is limited to 6 hours in 24 on Android 15, and no other type fits a game that plays with
             others over the network. Google Play would review the subtype; this app is not there. -->
        <service
            android:name=".NetworkGameService"
            android:process=":game"
            android:exported="false"
            android:foregroundServiceType="specialUse">
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="A running network game of the player, whose other players wait for it in lockstep." />
        </service>

        <!-- Hands the results zip to the app the user shares it with (read-only, by grant). -->
        <provider
            android:name=".ResultsProvider"
            android:authorities="io.github.m3rt1n99.fafre.results"
            android:exported="false"
            android:grantUriPermissions="true" />
    </application>
</manifest>
