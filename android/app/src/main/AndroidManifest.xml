<?xml version="1.0" encoding="utf-8"?>
<!--
  The engine test app: runs the engine's sim-math tests and plays FAF vault replays with
  the headless simulation (libfafheadless.so, started as its own process), checking every
  checksum the players recorded. See android/README.md.
-->
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- FAF's game files, replays, maps and mods (content.faforever.com, replay.faforever.com). -->
    <uses-permission android:name="android.permission.INTERNET" />
    <!-- TestService: downloads and test runs keep going with the screen off or the app in the background. -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_DATA_SYNC" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.WAKE_LOCK" />

    <!--
      hasFragileUserData: the imported game data (the user's own copy) lives in the app's
      external files dir; Android asks whether to keep it on uninstall. allowBackup is off: the
      data is the user's own copy of the game and far too large for a backup.
      extractNativeLibs: the tests start lib/<abi>/libfafheadless.so as a process, and an app may
      only start files from nativeLibraryDir, where only extracted lib*.so files land.
    -->
    <application
        android:allowBackup="false"
        android:extractNativeLibs="true"
        android:hasFragileUserData="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:theme="@style/Theme.FafRe"
        tools:targetApi="29">

        <activity
            android:name=".MainActivity"
            android:configChanges="orientation|screenSize|screenLayout|smallestScreenSize|keyboardHidden|density"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <service
            android:name=".TestService"
            android:exported="false"
            android:foregroundServiceType="dataSync" />

        <!-- Hands the results zip to the app the user shares it with (read-only, by grant). -->
        <provider
            android:name=".ResultsProvider"
            android:authorities="io.github.m3rt1n99.fafre.results"
            android:exported="false"
            android:grantUriPermissions="true" />
    </application>
</manifest>
